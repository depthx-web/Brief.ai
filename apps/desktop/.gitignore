# Rust build artifacts — regenerated by `cargo build` / `tauri build`.
src-tauri/target/

# Downloaded/extracted third-party binary sources (qpdf, Ghostscript,
# poppler installers and their extracted trees) — large (100s of MB) and
# fully reproducible from their public download URLs, so not committed.
# See src-tauri/binaries-src/ for what's expected to be staged here before
# a bundled build; a setup script to (re)populate it is a follow-up TODO.
src-tauri/binaries-src/

# Renamed sidecar binaries + their bundled DLL resources, staged from
# binaries-src/ before a `tauri build`. Small individually but kept out of
# git for the same reproducibility reason as binaries-src/.
src-tauri/binaries/

# WiX/NSIS installer output.
src-tauri/target/*/bundle/
