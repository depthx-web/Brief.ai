datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ConversionStatus {
  PROCESSING
  SUCCESS
  FAILED
}

// Audit log only — file contents are never persisted, only converted
// in-memory/temp-disk and streamed back, per the privacy-first architecture.
model ConversionJob {
  id               String           @id @default(uuid())
  originalFilename String
  sourceFormat     String
  targetFormat     String
  status           ConversionStatus @default(PROCESSING)
  errorMessage     String?          @db.Text
  durationMs       Int?
  createdAt        DateTime         @default(now())
}

enum PasswordOperation {
  PROTECT
  UNLOCK
}

// Audit log only — passwords and file contents are never persisted.
model PasswordJob {
  id               String            @id @default(uuid())
  originalFilename String
  operation        PasswordOperation
  status           ConversionStatus  @default(PROCESSING)
  errorMessage     String?           @db.Text
  durationMs       Int?
  createdAt        DateTime          @default(now())
}

enum AiOperation {
  SUMMARIZE
  CHAT
  ANALYZE_CLAUSES
  EXTRACT_REFERENCES
  EXTRACT_INVOICE
  // Batch 4 — Lawyer
  COMPARE_CONTRACTS
  SUMMARIZE_PLAIN
  AUDIT_NDA
  DETECT_SENSITIVE_DATA
  // Batch 4 — Accountant
  ANALYZE_FINANCIAL_RATIOS
  RECONCILE_BANK
  FLAG_DEDUCTIBLE_EXPENSES
  DETECT_DUPLICATE_PAYMENTS
  // Batch 4 — Researcher
  COMPARE_PAPERS
  EXTRACT_METHODOLOGY
  GENERATE_OUTLINE
}

// Audit log only — document text and conversation content are never
// persisted, only sent to the LLM provider for the single request.
// userId is optional: AI tools work anonymously too, and are only tagged to
// an account when the caller happens to be logged in (used for the lawyer
// audit log / researcher usage-tracking view in Settings).
model AiJob {
  id            String      @id @default(uuid())
  userId        String?
  operation     AiOperation
  status        ConversionStatus @default(PROCESSING)
  errorMessage  String?     @db.Text
  durationMs    Int?
  createdAt     DateTime    @default(now())

  @@index([userId])
}

enum Segment {
  LAWYER
  ACCOUNTANT
  RESEARCHER
}

enum Plan {
  FREE
  PAID
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum UserStatus {
  ACTIVE
  BANNED
}

// Opt-in accounts — only created when a user explicitly signs up to use the
// library/semantic-search feature. Every other tool in the app stays anonymous.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  segment      Segment?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())

  // Default retention applied to new uploads when the client doesn't pass
  // an explicit retentionDays (Settings -> Privacy -> "Default file
  // retention"). Null falls back to the platform default of 24h. 0 means
  // "Never" (paid plans only, enforced in the service layer).
  defaultRetentionHours Int?

  // Email verification (signup_confirmation trigger) — null means
  // unverified. Existing accounts are backfilled as already verified at
  // migration time (see the migration's UPDATE) so this never locks anyone
  // out retroactively; only new signups start unverified.
  emailVerifiedAt             DateTime?
  emailVerificationToken      String?   @unique
  emailVerificationExpiresAt  DateTime?

  documents    LibraryDocument[]
  projects     Project[]
  signatures   SavedSignature[]
  creditTransactions CreditTransaction[]

  // Billing (Lemon Squeezy). plan/billingCycle reflect the last-confirmed
  // subscription state, synced via the Lemon Squeezy webhook — not the
  // source of truth for entitlement while a payment is mid-flight.
  plan                        Plan          @default(FREE)
  billingCycle                BillingCycle?
  lemonSqueezyCustomerId       String?
  lemonSqueezySubscriptionId   String?       @unique
  subscriptionStatus           String?
  currentPeriodEnd             DateTime?

  // LiteLLM proxy virtual key — provisioned lazily on first AI call so a
  // per-account budget can be enforced by the proxy itself, not just by us.
  liteLlmVirtualKey            String?       @db.Text

  // Win-back campaign bookkeeping: cancelledAt starts the wait period,
  // winBackEmailSentAt prevents sending it more than once per cancellation.
  subscriptionCancelledAt      DateTime?
  winBackEmailSentAt           DateTime?

  paymentTransactions          PaymentTransaction[]

  // Dunning (Batch 5, Part 9 §2.1): incremented on each subscription_payment_failed
  // webhook, reset to 0 on the next subscription_payment_success. Drives both
  // the admin "Failed Payments" list and the automatic-retry cron.
  dunningAttemptCount          Int       @default(0)
  lastPaymentFailedAt          DateTime?
  nextDunningRetryAt           DateTime?

  // --- Affiliate program (Batch 5, Part 9 §4) -----------------------------
  // A direct self-relation rather than a separate ReferralRelationship join
  // table (spec's literal schema): each user has at most one referrer, ever,
  // set once at signup — a plain nullable FK captures that exactly, and the
  // referrals list/commission history is already fully queryable from
  // Commission rows keyed by referredUserId, so a join table would just
  // duplicate the same one fact.
  affiliateLink       AffiliateLink?
  referredByUserId    String?
  referredBy          User?           @relation("Referrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals           User[]          @relation("Referrals")
  commissionsEarned   Commission[]    @relation("ReferrerCommissions")
  commissionsFromMe   Commission[]    @relation("ReferredCommissions")
  payoutRequests      PayoutRequest[]

  // --- Team accounts (Batch: Team Settings) -------------------------------
  // Included with an existing paid plan, not a separately purchased add-on
  // — TeamController gates team creation on plan === 'PAID', nothing more.
  ownedTeams          Team[]              @relation("TeamOwner")
  teamMemberships     TeamMember[]
  sentInvitations     TeamInvitation[]    @relation("InvitationsSent")
  teamMemberSettings  TeamMemberSettings[]
}

enum AffiliateLinkStatus {
  ACTIVE
  BLOCKED
}

model AffiliateLink {
  id        String              @id @default(uuid())
  userId    String              @unique
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String              @unique
  status    AffiliateLinkStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  clicks    ClickEvent[]
}

// One row per visit to a referral link, whether or not it later converts —
// the click count shown in the referral page's stats is COUNT(*) here,
// independent of the Commission/referral rows.
model ClickEvent {
  id              String        @id @default(uuid())
  affiliateLinkId String
  affiliateLink   AffiliateLink @relation(fields: [affiliateLinkId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([affiliateLinkId])
}

enum CommissionType {
  SIGNUP
  RENEWAL
}

// One row per commission-earning payment event (Part 9 §4.3): 5% on the
// referred user's first payment, 3% on every renewal after, for as long as
// they stay subscribed. This *is* the withdrawable-earnings ledger — a
// user's balance is SUM(amountCents) here minus SUM(amountCents) of their
// non-rejected PayoutRequests, mirroring the credit-balance-as-ledger-sum
// pattern used elsewhere rather than a separately cached balance column.
model Commission {
  id             String         @id @default(uuid())
  referrerUserId String
  referrer       User           @relation("ReferrerCommissions", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referredUserId String
  referred       User           @relation("ReferredCommissions", fields: [referredUserId], references: [id], onDelete: Cascade)
  type           CommissionType
  amountCents    Int
  createdAt      DateTime       @default(now())

  @@index([referrerUserId])
  @@index([referredUserId])
}

enum PayoutMethod {
  BANK_TRANSFER
  PAYPAL
}

enum PayoutStatus {
  UNDER_REVIEW
  COMPLETED
}

model PayoutRequest {
  id     String       @id @default(uuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  method PayoutMethod
  // Requested amount, before any fee; netAmountCents is what the affiliate
  // actually receives (PayPal fee deducted per Part 9 §4.3; bank transfer
  // carries no deduction so netAmountCents == amountCents for that method).
  amountCents    Int
  netAmountCents Int
  // Bank transfer: { bankName, accountNumber, accountHolder }. PayPal: { paypalEmail }.
  details              Json
  status               PayoutStatus @default(UNDER_REVIEW)
  // Set by "Mark as paid manually" in the admin panel for payouts made
  // outside the system.
  transactionReference String?
  createdAt            DateTime     @default(now())
  completedAt          DateTime?

  @@index([userId])
  @@index([status])
}

enum EmailCampaignKey {
  WELCOME
  UPGRADE
  WINBACK
  SECURITY
  RETENTION_WARNING
  SIGNUP_CONFIRMATION
  PAYMENT_RECEIPT
  PLAN_CHANGED
  CANCELLATION_CONFIRMATION
  REFERRAL_SUCCESS
  TEAM_INVITATION
}

// Admin-editable email automations. body is a template with a small set of
// {{PLACEHOLDER}} tokens substituted per-send (e.g. {{DISCOUNT_CODE}} for
// the win-back email) — see EmailCampaignService.
model EmailCampaign {
  id      String           @id @default(uuid())
  key     EmailCampaignKey @unique
  enabled Boolean          @default(true)
  subject String
  body    String           @db.Text
}

// A bundle of files uploaded together on the Library page (Batch 3, Section
// 2). Every project carries its own retention clock — expiresAt starts at
// 24h and is pushed out by extendRetention (7 or 30 days) — and is swept by
// ProjectRetentionService once it lapses, cascading out its documents.
model Project {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // One of the segment's docType chips (e.g. "Contract", "Invoice") at
  // creation time — drives the card's top-strip accent color on the grid.
  category  String?
  createdAt DateTime          @default(now())
  documents LibraryDocument[]

  // --- Team sharing (Batch: Team Permissions) -----------------------------
  // Null teamId = not part of a team (the vast majority of projects).
  // Every project defaults to PRIVATE even inside a team — sharing is an
  // explicit opt-in per project, never automatic just from team membership.
  teamId     String?
  team       Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  visibility ProjectVisibility @default(PRIVATE)

  @@index([userId])
  @@index([teamId])
}

enum TeamMemberRole {
  OWNER
  MEMBER
}

enum TeamMemberStatus {
  ACTIVE
  INVITED
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum ProjectVisibility {
  PRIVATE
  SHARED_WITH_TEAM
}

// A team is created by (and always has exactly one) paid-plan owner —
// TeamController enforces that at creation time, not a DB constraint,
// since Prisma has no "role = OWNER implies plan = PAID" check.
model Team {
  id          String   @id @default(uuid())
  name        String
  ownerUserId String
  owner       User     @relation("TeamOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  members        TeamMember[]
  invitations    TeamInvitation[]
  memberSettings TeamMemberSettings[]
  projects       Project[]

  @@index([ownerUserId])
}

// One row per person actually in the team (owner included, role OWNER,
// status ACTIVE from creation) — TeamInvitation is the separate pending-
// invite record; a row here only exists once an invite is accepted (or
// for the owner, from the start).
model TeamMember {
  id       String           @id @default(uuid())
  teamId   String
  team     Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     TeamMemberRole   @default(MEMBER)
  status   TeamMemberStatus @default(ACTIVE)
  joinedAt DateTime         @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvitation {
  id              String               @id @default(uuid())
  teamId          String
  team            Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email           String
  invitedByUserId String
  invitedBy       User                 @relation("InvitationsSent", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  token           String               @unique
  status          TeamInvitationStatus @default(PENDING)
  createdAt       DateTime             @default(now())
  expiresAt       DateTime

  @@index([teamId])
  @@index([email])
}

// Owner-set overrides for one member — created lazily (only once an owner
// actually sets something), defaults (no cap, sharing allowed) apply to
// any member with no row here.
model TeamMemberSettings {
  id                  String  @id @default(uuid())
  teamId              String
  team                Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId              String
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenBudgetOverride Int?
  canShareProjects    Boolean @default(true)

  @@unique([teamId, userId])
}

// Small enough (a canvas drawing or a compact uploaded image) to store as a
// data URL directly rather than round-tripping through StorageService —
// avoids a file-storage dependency for what's rarely more than a few KB.
model SavedSignature {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  imageData String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
}

// Opt-in persistent storage — the file and its embedding are kept only
// because the user explicitly added it to their personal library.
model LibraryDocument {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String
  storagePath  String
  extractedText String  @db.LongText
  embedding    Json
  // Free-text sub-type picked at upload (e.g. "NDA", "Invoice") from the
  // segment-specific chip list on the dashboard — passed to the AI layer as
  // extra context so, e.g., an NDA and a court memo get differently-focused
  // analysis despite both being LAWYER-segment documents.
  docType      String?
  createdAt    DateTime @default(now())

  // Nullable: documents uploaded before Batch 3 (or via the Dashboard's
  // quick-upload, which bypasses the project flow) have no project and are
  // shown as "Unsorted" on the Library page instead of a retention card.
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Retention lives per-file, not per-project (Batch 5 fix) — a long-running
  // project shouldn't be wiped out because one old file in it expired while
  // the rest are recent. Null for documents with no project (never expire).
  expiresAt    DateTime?
  // Set once the "1 hour left" retention-warning email has gone out for
  // this file, so the scheduled job never sends it twice.
  retentionWarningSent Boolean @default(false)

  @@index([userId])
  @@index([projectId])
  @@index([expiresAt])
}

// Admin-editable price per segment x cycle — seeded from the original
// arithmetic (10%/20% off quarterly/yearly), but each cell is a standalone
// row an admin can override directly, per the admin panel spec.
model PlanPrice {
  id         String       @id @default(uuid())
  segment    Segment
  cycle      BillingCycle
  priceCents Int
  updatedAt  DateTime     @updatedAt

  @@unique([segment, cycle])
}

// Per-segment feature entitlement, toggleable live from the admin panel.
// freeEnabled controls whether FREE-plan users in that segment can use it
// (checked by FeatureGuard on the AI endpoints); proEnabled is currently
// always true in practice but kept for a future "some features are Pro-only
// too" case without a schema change.
// segment is nullable to represent a tool available to every workspace
// (Office<->PDF conversion, Protect, Remove Password) rather than one
// profession's AI operation — FeatureGuard checks a null-segment row
// regardless of the caller's own segment. Note: MySQL's unique index
// permits multiple NULLs, so this doesn't hard-block a duplicate global key
// at the DB level — acceptable since Feature rows are only ever seeded via
// migration, never created ad hoc from an API.
model Feature {
  id          String   @id @default(uuid())
  segment     Segment?
  key         String
  label       String
  freeEnabled Boolean  @default(false)
  proEnabled  Boolean  @default(true)
  order       Int      @default(0)

  @@unique([segment, key])
}

enum DiscountType {
  PERCENT
  FIXED
}

// Admin-issued codes, validated and counted at our end. applicableSegments
// stores the segment list as JSON (e.g. ["LAWYER","RESEARCHER"]) rather than
// a join table — a code's segment scope is small and never queried on its
// own. `revoked` is a distinct, immediate off-switch from `expiresAt`/
// `usageLimit`, which lapse naturally instead of being explicitly pulled.
model DiscountCode {
  id                 String       @id @default(uuid())
  code               String       @unique
  type               DiscountType
  value              Int
  expiresAt          DateTime?
  usageLimit         Int?
  usageCount         Int          @default(0)
  applicableSegments Json
  revoked            Boolean      @default(false)
  createdAt          DateTime     @default(now())
}

// --- Content management (Batch 5, Part 9 §1) --------------------------------
// Draft/publish is modeled as two JSON blobs per section rather than the
// master spec's literal draft|published status enum on a single row: an
// enum can't represent "an edited draft exists alongside a still-live
// published version" at the same time, which the mandatory draft->publish
// flow (Part 9 §1.3) requires — an admin must be able to preview unpublished
// edits without touching what visitors currently see.

model Page {
  id              String            @id @default(uuid())
  slug            String            @unique
  metaTitle       String?
  metaDescription String?           @db.Text
  metaKeywords    Json?
  ogImageUrl      String?
  sections        ContentSection[]
}

model ContentSection {
  id              String   @id @default(uuid())
  pageId          String
  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  // Matches the actual component key in code (e.g. "hero", "faq").
  sectionKey      String
  order           Int      @default(0)
  draftFields     Json
  // Null until the first publish — public pages fall back to the
  // hardcoded default copy in code when this is null, so an unpublished
  // page never renders blank/broken content.
  publishedFields Json?
  updatedAt       DateTime @updatedAt

  @@unique([pageId, sectionKey])
}

// --- Usage-based AI credits (Batch 5, Part 6 §7) ---------------------------

// Pre-paid packs sold on the Pricing page's "Pay as you go" tab, alongside
// (not instead of) the subscription cycles.
model CreditPack {
  id          String  @id @default(uuid())
  size        Int
  priceCents  Int
  isBestValue Boolean @default(false)
  order       Int     @default(0)
  // Set by an admin once the matching one-time-purchase product is created
  // in Lemon Squeezy — packs are admin-created dynamically, unlike the
  // fixed segment×cycle subscription matrix, so this can't live in an env
  // var the way LEMON_SQUEEZY_VARIANT_* does for subscriptions.
  lemonSqueezyVariantId String?
}

enum CreditTransactionReason {
  PURCHASE
  AI_USAGE
  MANUAL_ADMIN_ADJUSTMENT
}

// No separate balance table — a user's balance is SUM(delta) over their own
// transactions. Slightly more to compute than a cached counter, but it can
// never drift out of sync with the ledger, which matters more here.
model CreditTransaction {
  id        String                   @id @default(uuid())
  userId    String
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    CreditTransactionReason
  // Mandatory when reason = MANUAL_ADMIN_ADJUSTMENT (enforced in the
  // service layer, not the DB) — every manual balance change needs a
  // human-readable justification for the audit trail.
  adminNote String?                  @db.Text
  createdAt DateTime                 @default(now())

  @@index([userId])
}

// Single-row table for admin-editable platform-wide settings that don't
// belong to any one feature's own table — referenced by both the credits
// system (creditsEnabled) and the affiliate program (commission/fee rates).
model PlatformSettings {
  id                       String   @id @default("singleton")
  creditsEnabled           Boolean  @default(true)
  // Global kill-switch for the "Lemon Squeezy" provider card in the admin
  // Billing section (Part 9 §2.1) — checkout/credit-checkout both check this.
  paymentsEnabled          Boolean  @default(true)
  commissionSignupPercent  Int      @default(5)
  commissionRenewalPercent Int      @default(3)
  paypalFeePercent         Float    @default(2.9)
  paypalFeeFixedCents      Int      @default(30)

  // Dunning (Batch 5, Part 9 §2.1) — admin-editable so retry cadence can be
  // tuned without a deploy.
  dunningAutoRetryEnabled  Boolean  @default(true)
  dunningMaxAttempts       Int      @default(3)
  dunningIntervalDays      Int      @default(3)

  // Token Economics (admin panel): how AI-usage credit deductions/pack
  // pricing are expressed in real-money terms. Changing this is forward-only
  // — it doesn't retroactively alter past transactions.
  tokensPerDollar          Int      @default(500)

  updatedAt                DateTime @updatedAt
}

// --- Payments (Batch 5, Part 9 §2) ------------------------------------------

enum PaymentTransactionType {
  SUBSCRIPTION_PAYMENT
  CREDIT_PURCHASE
  REFUND
}

enum PaymentTransactionStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

// One row per real payment event reported by the Lemon Squeezy webhook —
// the admin "Transactions" table's source of truth (Part 9 §2.1), separate
// from CreditTransaction (that's the credit *ledger*, not money changing
// hands) and separate from User.subscriptionStatus (that's current state,
// not history).
model PaymentTransaction {
  id                  String                    @id @default(uuid())
  userId              String
  user                User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                PaymentTransactionType
  status              PaymentTransactionStatus
  amountCents         Int
  provider            String                    @default("LEMON_SQUEEZY")
  // Lemon Squeezy order or subscription-invoice id — needed to call the
  // refund API against the right resource later.
  providerReferenceId String?
  createdAt           DateTime                  @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
