datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ConversionStatus {
  PROCESSING
  SUCCESS
  FAILED
}

// Audit log only — file contents are never persisted, only converted
// in-memory/temp-disk and streamed back, per the privacy-first architecture.
model ConversionJob {
  id               String           @id @default(uuid())
  originalFilename String
  sourceFormat     String
  targetFormat     String
  status           ConversionStatus @default(PROCESSING)
  errorMessage     String?          @db.Text
  durationMs       Int?
  createdAt        DateTime         @default(now())
}

enum PasswordOperation {
  PROTECT
  UNLOCK
}

// Audit log only — passwords and file contents are never persisted.
model PasswordJob {
  id               String            @id @default(uuid())
  originalFilename String
  operation        PasswordOperation
  status           ConversionStatus  @default(PROCESSING)
  errorMessage     String?           @db.Text
  durationMs       Int?
  createdAt        DateTime          @default(now())
}

enum AiOperation {
  SUMMARIZE
  CHAT
  ANALYZE_CLAUSES
  EXTRACT_REFERENCES
  EXTRACT_INVOICE
}

// Audit log only — document text and conversation content are never
// persisted, only sent to the LLM provider for the single request.
// userId is optional: AI tools work anonymously too, and are only tagged to
// an account when the caller happens to be logged in (used for the lawyer
// audit log / researcher usage-tracking view in Settings).
model AiJob {
  id            String      @id @default(uuid())
  userId        String?
  operation     AiOperation
  status        ConversionStatus @default(PROCESSING)
  errorMessage  String?     @db.Text
  durationMs    Int?
  createdAt     DateTime    @default(now())

  @@index([userId])
}

enum Segment {
  LAWYER
  ACCOUNTANT
  RESEARCHER
}

enum Plan {
  FREE
  PAID
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum UserStatus {
  ACTIVE
  BANNED
}

// Opt-in accounts — only created when a user explicitly signs up to use the
// library/semantic-search feature. Every other tool in the app stays anonymous.
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  segment      Segment?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())
  documents    LibraryDocument[]
  projects     Project[]

  // Billing (Lemon Squeezy). plan/billingCycle reflect the last-confirmed
  // subscription state, synced via the Lemon Squeezy webhook — not the
  // source of truth for entitlement while a payment is mid-flight.
  plan                        Plan          @default(FREE)
  billingCycle                BillingCycle?
  lemonSqueezyCustomerId       String?
  lemonSqueezySubscriptionId   String?       @unique
  subscriptionStatus           String?
  currentPeriodEnd             DateTime?

  // LiteLLM proxy virtual key — provisioned lazily on first AI call so a
  // per-account budget can be enforced by the proxy itself, not just by us.
  liteLlmVirtualKey            String?       @db.Text

  // Win-back campaign bookkeeping: cancelledAt starts the wait period,
  // winBackEmailSentAt prevents sending it more than once per cancellation.
  subscriptionCancelledAt      DateTime?
  winBackEmailSentAt           DateTime?
}

enum EmailCampaignKey {
  WELCOME
  UPGRADE
  WINBACK
  SECURITY
}

// Admin-editable email automations. body is a template with a small set of
// {{PLACEHOLDER}} tokens substituted per-send (e.g. {{DISCOUNT_CODE}} for
// the win-back email) — see EmailCampaignService.
model EmailCampaign {
  id      String           @id @default(uuid())
  key     EmailCampaignKey @unique
  enabled Boolean          @default(true)
  subject String
  body    String           @db.Text
}

// A bundle of files uploaded together on the Library page (Batch 3, Section
// 2). Every project carries its own retention clock — expiresAt starts at
// 24h and is pushed out by extendRetention (7 or 30 days) — and is swept by
// ProjectRetentionService once it lapses, cascading out its documents.
model Project {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  // One of the segment's docType chips (e.g. "Contract", "Invoice") at
  // creation time — drives the card's top-strip accent color on the grid.
  category  String?
  createdAt DateTime          @default(now())
  expiresAt DateTime
  documents LibraryDocument[]

  @@index([userId])
  @@index([expiresAt])
}

// Opt-in persistent storage — the file and its embedding are kept only
// because the user explicitly added it to their personal library.
model LibraryDocument {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String
  storagePath  String
  extractedText String  @db.LongText
  embedding    Json
  // Free-text sub-type picked at upload (e.g. "NDA", "Invoice") from the
  // segment-specific chip list on the dashboard — passed to the AI layer as
  // extra context so, e.g., an NDA and a court memo get differently-focused
  // analysis despite both being LAWYER-segment documents.
  docType      String?
  createdAt    DateTime @default(now())

  // Nullable: documents uploaded before Batch 3 (or via the Dashboard's
  // quick-upload, which bypasses the project flow) have no project and are
  // shown as "Unsorted" on the Library page instead of a retention card.
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}

// Admin-editable price per segment x cycle — seeded from the original
// arithmetic (10%/20% off quarterly/yearly), but each cell is a standalone
// row an admin can override directly, per the admin panel spec.
model PlanPrice {
  id         String       @id @default(uuid())
  segment    Segment
  cycle      BillingCycle
  priceCents Int
  updatedAt  DateTime     @updatedAt

  @@unique([segment, cycle])
}

// Per-segment feature entitlement, toggleable live from the admin panel.
// freeEnabled controls whether FREE-plan users in that segment can use it
// (checked by FeatureGuard on the AI endpoints); proEnabled is currently
// always true in practice but kept for a future "some features are Pro-only
// too" case without a schema change.
model Feature {
  id          String  @id @default(uuid())
  segment     Segment
  key         String
  label       String
  freeEnabled Boolean @default(false)
  proEnabled  Boolean @default(true)
  order       Int     @default(0)

  @@unique([segment, key])
}

enum DiscountType {
  PERCENT
  FIXED
}

// Admin-issued codes, validated and counted at our end. applicableSegments
// stores the segment list as JSON (e.g. ["LAWYER","RESEARCHER"]) rather than
// a join table — a code's segment scope is small and never queried on its
// own. `revoked` is a distinct, immediate off-switch from `expiresAt`/
// `usageLimit`, which lapse naturally instead of being explicitly pulled.
model DiscountCode {
  id                 String       @id @default(uuid())
  code               String       @unique
  type               DiscountType
  value              Int
  expiresAt          DateTime?
  usageLimit         Int?
  usageCount         Int          @default(0)
  applicableSegments Json
  revoked            Boolean      @default(false)
  createdAt          DateTime     @default(now())
}
