DATABASE_URL="mysql://briefai:briefai_dev_password@localhost:3306/briefai"
PORT=3001
CORS_ORIGIN=http://localhost:3000
SOFFICE_BIN=soffice
CONVERSION_TIMEOUT_MS=60000
QPDF_BIN=qpdf

# DeepSeek by default (OpenAI-compatible API). Swap LLM_BASE_URL/LLM_MODEL to
# point at a different OpenAI-compatible provider if needed.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Only used by the opt-in "My Library" feature (accounts + saved documents).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
STORAGE_DIR=./storage

# Internal ops dashboard at /admin — a shared secret, not a user account.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
