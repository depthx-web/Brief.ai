DATABASE_URL="mysql://briefai:briefai_dev_password@localhost:3306/briefai"
PORT=3001
CORS_ORIGIN=http://localhost:3000
SOFFICE_BIN=soffice
CONVERSION_TIMEOUT_MS=60000
QPDF_BIN=qpdf

# DeepSeek by default (OpenAI-compatible API). Swap LLM_BASE_URL/LLM_MODEL to
# point at a different OpenAI-compatible provider if needed.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Only used by the opt-in "My Library" feature (accounts + saved documents).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
STORAGE_DIR=./storage

# Internal ops dashboard at /admin — a shared secret, not a user account.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Free plan gate: when true, AI/OCR/server-side conversion/password routes
# require a PAID user. Leave false until Lemon Squeezy is fully configured
# below, or every user (including you) gets locked out of these tools.
BILLING_ENFORCED=false

# Lemon Squeezy (Merchant of Record) — leave unset to keep /billing/checkout
# returning a clear "not configured" error instead of crashing.
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
# Signing secret from the webhook's settings page in the Lemon Squeezy dashboard.
LEMON_SQUEEZY_WEBHOOK_SECRET=

# One product variant ID per segment x billing cycle (12 total), from each
# variant's page in the Lemon Squeezy dashboard.
LEMON_SQUEEZY_VARIANT_LAWYER_WEEKLY=
LEMON_SQUEEZY_VARIANT_LAWYER_MONTHLY=
LEMON_SQUEEZY_VARIANT_LAWYER_QUARTERLY=
LEMON_SQUEEZY_VARIANT_LAWYER_YEARLY=
LEMON_SQUEEZY_VARIANT_ACCOUNTANT_WEEKLY=
LEMON_SQUEEZY_VARIANT_ACCOUNTANT_MONTHLY=
LEMON_SQUEEZY_VARIANT_ACCOUNTANT_QUARTERLY=
LEMON_SQUEEZY_VARIANT_ACCOUNTANT_YEARLY=
LEMON_SQUEEZY_VARIANT_RESEARCHER_WEEKLY=
LEMON_SQUEEZY_VARIANT_RESEARCHER_MONTHLY=
LEMON_SQUEEZY_VARIANT_RESEARCHER_QUARTERLY=
LEMON_SQUEEZY_VARIANT_RESEARCHER_YEARLY=

# LiteLLM proxy (see docker/litellm-config.yaml). Point the app at the
# self-hosted proxy instead of calling a provider directly.
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=
# Provider keys the proxy itself uses — set these to swap task-simple/
# task-complex off the DeepSeek default and onto Gemini/Claude/GPT.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Email campaigns (welcome / upgrade confirmation / win-back) — leave
# RESEND_API_KEY unset to log intended sends instead of actually sending.
RESEND_API_KEY=
MAIL_FROM="Brief.ai <noreply@brief.ai>"
# Used to build links in emails (dashboard, pricing) — set to the deployed
# frontend URL in production.
APP_URL=http://localhost:3000
