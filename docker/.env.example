LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Generate with: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Free plan gate — leave false until Lemon Squeezy is fully configured below.
BILLING_ENFORCED=false

# Lemon Squeezy (Merchant of Record)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_VARIANT_LAWYER_WEEKLY=
LEMON_SQUEEZY_VARIANT_LAWYER_MONTHLY=
LEMON_SQUEEZY_VARIANT_LAWYER_QUARTERLY=
LEMON_SQUEEZY_VARIANT_LAWYER_YEARLY=
LEMON_SQUEEZY_VARIANT_ACCOUNTANT_WEEKLY=
LEMON_SQUEEZY_VARIANT_ACCOUNTANT_MONTHLY=
LEMON_SQUEEZY_VARIANT_ACCOUNTANT_QUARTERLY=
LEMON_SQUEEZY_VARIANT_ACCOUNTANT_YEARLY=
LEMON_SQUEEZY_VARIANT_RESEARCHER_WEEKLY=
LEMON_SQUEEZY_VARIANT_RESEARCHER_MONTHLY=
LEMON_SQUEEZY_VARIANT_RESEARCHER_QUARTERLY=
LEMON_SQUEEZY_VARIANT_RESEARCHER_YEARLY=

# LiteLLM proxy — self-hosted model router (see docker/litellm-config.yaml)
LITELLM_MASTER_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Email campaigns — leave RESEND_API_KEY unset to log intended sends instead
# of actually sending.
RESEND_API_KEY=
MAIL_FROM="Brief.ai <noreply@brief.ai>"
APP_URL=http://localhost:3000
